import csv
import os
from datetime import datetime

arquivo = pasta + "/despesas.csv"

# 1 - Cadastrar despesa
def cadastrar():
    try:
        valor = float(input("Digite o valor da despesa: "))

        if valor <= 0:
            print("O valor deve ser maior que zero.")
            return

        data = datetime.now().strftime("%d/%m/%Y")

        novo_arquivo = not os.path.exists(arquivo)

        with open(arquivo, "a", newline="", encoding="utf-8") as f:
            escritor = csv.DictWriter(
                f, fieldnames=["data", "valor"]
            )

            if novo_arquivo or os.path.getsize(arquivo) == 0:
                escritor.writeheader()

            escritor.writerow({
                "data": data,
                "valor": valor
            })

        print("Despesa cadastrada com sucesso!")

    except ValueError:
        print("Digite um valor numerico valido.")


# 2 - Consultar despesas
def consultar():
    if not os.path.exists(arquivo):
        print("Nenhuma despesa encontrada.")
        return

    with open(arquivo, "r", encoding="utf-8") as f:
        leitor = csv.DictReader(f)
        registros = list(leitor)

    if not registros:
        print("Nenhuma despesa cadastrada.")
        return

    print("\n=== DESPESAS CADASTRADAS ===")

    for numero, registro in enumerate(registros, start=1):
        valor = float(registro["valor"])
        print(f"{numero} - {registro['data']} | R$ {valor:.2f}")


# 3 - Excluir despesa
def excluir_despesa():
    if not os.path.exists(arquivo):
        print("Nenhuma despesa encontrada.")
        return

    with open(arquivo, "r", encoding="utf-8") as f:
        registros = list(csv.DictReader(f))

    if not registros:
        print("Nenhuma despesa cadastrada.")
        return

    consultar()

    try:
        escolha = int(input("Numero da despesa para excluir: "))

        if 1 <= escolha <= len(registros):
            removido = registros.pop(escolha - 1)

            with open(arquivo, "w", newline="", encoding="utf-8") as f:
                escritor = csv.DictWriter(
                    f, fieldnames=["data", "valor"]
                )
                escritor.writeheader()
                escritor.writerows(registros)

            print("Despesa excluida!")
            print("Valor removido: R$", removido["valor"])

        else:
            print("Numero inexistente.")

    except ValueError:
        print("Digite um numero valido.")


# 4 - Calcular total
def calcular_total():
    if not os.path.exists(arquivo):
        print("Nenhuma despesa encontrada.")
        return

    total = 0

    with open(arquivo, "r", encoding="utf-8") as f:
        leitor = csv.DictReader(f)

        for registro in leitor:
            total += float(registro["valor"])

    print(f"Total das despesas: R$ {total:.2f}")

# 5 - Gerar relatorio
def gerar_relatorio():
    if not os.path.exists(arquivo):
        print("Nenhuma despesa encontrada.")
        return

    total = 0

    with open(arquivo, "r", encoding="utf-8") as f:
        leitor = csv.DictReader(f)

        for registro in leitor:
            total += float(registro["valor"])

    print(f"Total das despesas: R$ {total:.2f}")

# 6 - Menu principal
while True:
    print("\n=== CONTROLE FINANCEIRO ===")
    print("1 - Cadastrar despesa")
    print("2 - Consultar despesas")
    print("3 - Excluir despesa")
    print("4 - Calcular o total")
    print("5 - Sair")
    print("6 - Gerar relatorio financeiro")

    opcao = input("Escolha uma opcao: ")

    if opcao == "1":
        cadastrar()

    elif opcao == "2":
        consultar()

    elif opcao == "3":
        excluir_despesa()

    elif opcao == "4":
        calcular_total()

    elif opcao == "5":
        print("Sistema encerrado!")
        break

    elif opcao == "6":
        gerar_relatorio()

    else:
        print("Opcao invalida!")
